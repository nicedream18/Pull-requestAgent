# DeepSeek API credentials (required)
DEEPSEEK_API_KEY=sk-your-deepseek-api-key

# Optional: override the API endpoint (defaults to https://api.deepseek.com/v1)
DEEPSEEK_API_BASE=https://api.deepseek.com/v1

# Optional: override the model (defaults to deepseek/deepseek-chat from agents.yaml)
DEEPSEEK_MODEL=deepseek/deepseek-chat

# Optional generic OpenAI-compatible provider settings.
# PRGUARD_MODEL=openai/your-model
# PRGUARD_API_KEY=your-api-key

# CrewAI local runtime settings. Disable anonymous telemetry for reproducible
# local demos and avoid concurrent tracer-provider initialization warnings.
OTEL_SDK_DISABLED=true
# Optional namespace for CrewAI's local SQLite task-output store.
# CREWAI_STORAGE_DIR=prguard

# Optional USD prices per one million tokens for estimated online cost.
# PRGUARD_INPUT_PRICE_PER_1M=0
# PRGUARD_OUTPUT_PRICE_PER_1M=0

# GitHub token used to look up related PRs and files (optional)
# Create one at https://github.com/settings/personal-access-tokens/new (or /tokens/new for classic).
# Public repos only need read access; private repos need Contents + Pull requests read.
# GITHUB_TOKEN_CODEREVIEW=ghp_your-github-token

# Optional inputs for the retained upstream `run_crew` entry point.
# REVIEW_REPO=owner/repo
# REVIEW_PR_PATCH_URL=https://github.com/owner/repo/pull/123.patch
